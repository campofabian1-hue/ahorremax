rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      function owner() {
        return request.auth != null && request.auth.uid == userId;
      }
      function planPath(planId) {
        return /databases/$(database)/documents/users/$(userId)/plans/$(planId);
      }
      function operationPath(operationId) {
        return /databases/$(database)/documents/users/$(userId)/operations/$(operationId);
      }
      function dreamPath() {
        return /databases/$(database)/documents/users/$(userId)/plans/dream;
      }
      function dreamOperationPath(operationId) {
        return /databases/$(database)/documents/users/$(userId)/dreamOperations/$(operationId);
      }
      function dreamPhotoPath() {
        return /databases/$(database)/documents/users/$(userId)/dreamMedia/cover;
      }
      function dreamMediaOperationPath(operationId) {
        return /databases/$(database)/documents/users/$(userId)/dreamMediaOperations/$(operationId);
      }
      function validDreamMedia() {
        let d = request.resource.data;
        return d.keys().hasAll(['imageData','revision','lastOperationId','updatedAt'])
          && d.keys().hasOnly(['imageData','revision','lastOperationId','updatedAt'])
          && d.imageData is string && d.imageData.size() <= 450000
          && (d.imageData == '' || d.imageData.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$'))
          && d.revision is int && d.revision >= 1
          && d.lastOperationId is string && d.lastOperationId.matches('^[a-f0-9-]{36}$')
          && d.updatedAt == request.time;
      }
      function validDreamMediaOperation() {
        let d = request.resource.data;
        return d.keys().hasAll(['type','revision','createdAt'])
          && d.keys().hasOnly(['type','revision','createdAt'])
          && d.type in ['photo_added','photo_updated','photo_removed']
          && d.revision is int && d.revision >= 1
          && d.createdAt == request.time;
      }
      function dreamMediaOperationCommitted() {
        let d = request.resource.data;
        return existsAfter(dreamMediaOperationPath(d.lastOperationId))
          && getAfter(dreamMediaOperationPath(d.lastOperationId)).data.revision == d.revision
          && ((d.imageData == '' && getAfter(dreamMediaOperationPath(d.lastOperationId)).data.type == 'photo_removed')
            || (d.imageData != '' && getAfter(dreamMediaOperationPath(d.lastOperationId)).data.type in ['photo_added','photo_updated']));
      }
      function validPlan() {
        let d = request.resource.data;
        return d.keys().hasAll(['mode','place','placeName','purpose','startDate','entries','revision','lastOperationId','updatedAt'])
          && d.keys().hasOnly(['mode','place','placeName','purpose','startDate','entries','revision','lastOperationId','updatedAt'])
          && d.mode in ['weekly','daily','flexible']
          && d.place in ['account','pocket','cash']
          && d.placeName is string && d.placeName.size() <= 60
          && d.purpose is string && d.purpose.size() >= 3 && d.purpose.size() <= 80
          && d.startDate is string && d.startDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && d.entries is list && d.entries.size() <= 200
          && d.revision is int && d.revision >= 1
          && d.lastOperationId is string && d.lastOperationId.matches('^[a-f0-9-]{36}$')
          && d.updatedAt == request.time;
      }
      function operationCommittedWithPlan() {
        let d = request.resource.data;
        return existsAfter(operationPath(d.lastOperationId))
          && getAfter(operationPath(d.lastOperationId)).data.revision == d.revision
          && getAfter(operationPath(d.lastOperationId)).data.mode == d.mode
          && getAfter(operationPath(d.lastOperationId)).data.purpose == d.purpose;
      }
      function operationMatchesPlan(planId, operationId) {
        return existsAfter(planPath(planId))
          && getAfter(planPath(planId)).data.lastOperationId == operationId
          && getAfter(planPath(planId)).data.revision == request.resource.data.revision
          && getAfter(planPath(planId)).data.mode == request.resource.data.mode
          && getAfter(planPath(planId)).data.purpose == request.resource.data.purpose;
      }
      function validOperation() {
        let d = request.resource.data;
        return d.keys().hasAll(['type','revision','mode','amount','ids','entryId','shortcut','purpose','createdAt'])
          && d.keys().hasOnly(['type','revision','mode','amount','ids','entryId','shortcut','purpose','createdAt'])
          && d.type in ['plan_created','contribution_added','contribution_corrected','goal_updated']
          && d.revision is int && d.revision >= 1
          && d.mode in ['weekly','daily','flexible']
          && d.amount is int && d.amount >= 0 && d.amount <= 1195000
          && d.ids is list && d.ids.size() <= 200
          && d.entryId is string && d.entryId.size() <= 100
          && d.shortcut in ['','smile','heart','music','sun','triangle']
          && d.purpose is string && d.purpose.size() >= 3 && d.purpose.size() <= 80
          && d.createdAt == request.time
          && ((d.type in ['plan_created','goal_updated'] && d.amount == 0 && d.ids.size() == 0 && d.entryId == '')
            || (d.type in ['contribution_added','contribution_corrected'] && d.amount > 0 && d.ids.size() > 0 && d.entryId.size() > 0));
      }
      function validDreamPlan() {
        let d = request.resource.data;
        return d.keys().hasAll(['mode','purpose','goal','cadence','strategy','startDate','targetDate','contribution','periods','projectedDate','place','placeName','saved','entries','revision','lastOperationId','updatedAt'])
          && d.keys().hasOnly(['mode','purpose','goal','cadence','strategy','startDate','targetDate','contribution','periods','projectedDate','place','placeName','saved','entries','revision','lastOperationId','updatedAt'])
          && d.mode == 'dream'
          && d.purpose is string && d.purpose.size() >= 3 && d.purpose.size() <= 80
          && d.goal is int && d.goal >= 1000 && d.goal <= 1000000000
          && d.cadence in ['daily','weekly','fortnightly','monthly']
          && d.strategy in ['deadline','amount']
          && d.startDate is string && d.startDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && d.targetDate is string && (d.targetDate == '' || d.targetDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
          && d.projectedDate is string && d.projectedDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && d.contribution is int && d.contribution >= 1 && d.contribution <= d.goal
          && d.periods is int && d.periods >= 1 && d.periods <= 3700
          && d.place in ['account','pocket','cash']
          && d.placeName is string && d.placeName.size() <= 60
          && d.saved is int && d.saved >= 0 && d.saved <= d.goal
          && d.entries is list && d.entries.size() <= 3700
          && d.revision is int && d.revision >= 1
          && d.lastOperationId is string && d.lastOperationId.matches('^[a-f0-9-]{36}$')
          && d.updatedAt == request.time;
      }
      function dreamOperationCommittedWithPlan() {
        let d = request.resource.data;
        return existsAfter(dreamOperationPath(d.lastOperationId))
          && getAfter(dreamOperationPath(d.lastOperationId)).data.revision == d.revision
          && getAfter(dreamOperationPath(d.lastOperationId)).data.purpose == d.purpose
          && getAfter(dreamOperationPath(d.lastOperationId)).data.goal == d.goal;
      }
      function validDreamOperation() {
        let d = request.resource.data;
        return d.keys().hasAll(['type','revision','amount','previousAmount','previousGoal','entryIndex','entryId','purpose','goal','createdAt'])
          && d.keys().hasOnly(['type','revision','amount','previousAmount','previousGoal','entryIndex','entryId','purpose','goal','createdAt'])
          && d.type in ['dream_created','dream_plan_updated','dream_contribution_added','dream_contribution_corrected','dream_contribution_edited']
          && d.revision is int && d.revision >= 1
          && d.amount is int && d.amount >= 0 && d.amount <= 1000000000
          && d.previousAmount is int && d.previousAmount >= 0 && d.previousAmount <= 1000000000
          && d.previousGoal is int && d.previousGoal >= 0 && d.previousGoal <= 1000000000
          && d.entryIndex is int && d.entryIndex >= -1 && d.entryIndex < 3700
          && d.entryId is string && d.entryId.size() <= 100
          && d.purpose is string && d.purpose.size() >= 3 && d.purpose.size() <= 80
          && d.goal is int && d.goal >= 1000 && d.goal <= 1000000000
          && d.createdAt == request.time
          && ((d.type == 'dream_created' && d.amount == 0 && d.previousAmount == 0 && d.previousGoal == 0 && d.entryIndex == -1 && d.entryId == '')
            || (d.type == 'dream_plan_updated' && d.amount > 0 && d.previousAmount > 0 && d.previousGoal >= 1000 && d.entryIndex == -1 && d.entryId == '')
            || (d.type == 'dream_contribution_added' && d.amount > 0 && d.previousAmount == 0 && d.previousGoal == 0 && d.entryIndex == -1 && d.entryId.size() > 0)
            || (d.type == 'dream_contribution_corrected' && d.amount > 0 && d.previousAmount == 0 && d.previousGoal == 0 && d.entryIndex >= 0 && d.entryId.size() > 0)
            || (d.type == 'dream_contribution_edited' && d.amount > 0 && d.previousAmount > 0 && d.previousGoal == 0 && d.entryIndex >= 0 && d.entryId.size() > 0));
      }
      function dreamTermsUnchanged() {
        return request.resource.data.goal == resource.data.goal
          && request.resource.data.purpose == resource.data.purpose
          && request.resource.data.cadence == resource.data.cadence
          && request.resource.data.strategy == resource.data.strategy
          && request.resource.data.startDate == resource.data.startDate
          && request.resource.data.targetDate == resource.data.targetDate
          && request.resource.data.contribution == resource.data.contribution
          && request.resource.data.periods == resource.data.periods
          && request.resource.data.projectedDate == resource.data.projectedDate
          && request.resource.data.place == resource.data.place
          && request.resource.data.placeName == resource.data.placeName;
      }
      function dreamChangeMatchesOperation() {
        let o = getAfter(dreamOperationPath(request.resource.data.lastOperationId)).data;
        return (o.type == 'dream_plan_updated'
            && request.resource.data.saved == resource.data.saved
            && request.resource.data.entries == resource.data.entries
            && o.amount == request.resource.data.contribution
            && o.previousAmount == resource.data.contribution
            && o.previousGoal == resource.data.goal)
          || (dreamTermsUnchanged() && (
            (o.type == 'dream_contribution_added'
              && request.resource.data.saved == resource.data.saved + o.amount
              && request.resource.data.entries.size() == resource.data.entries.size() + 1
              && request.resource.data.entries[resource.data.entries.size()].id == o.entryId
              && request.resource.data.entries[resource.data.entries.size()].amount == o.amount
              && request.resource.data.entries.removeAll([request.resource.data.entries[resource.data.entries.size()]]) == resource.data.entries)
            || (o.type == 'dream_contribution_corrected'
              && o.entryIndex < resource.data.entries.size()
              && resource.data.entries[o.entryIndex].id == o.entryId
              && resource.data.entries[o.entryIndex].amount == o.amount
              && request.resource.data.saved == resource.data.saved - o.amount
              && request.resource.data.entries == resource.data.entries.removeAll([resource.data.entries[o.entryIndex]]))
            || (o.type == 'dream_contribution_edited'
              && o.entryIndex < resource.data.entries.size()
              && request.resource.data.entries.size() == resource.data.entries.size()
              && resource.data.entries[o.entryIndex].id == o.entryId
              && request.resource.data.entries[o.entryIndex].id == o.entryId
              && resource.data.entries[o.entryIndex].amount == o.previousAmount
              && request.resource.data.entries[o.entryIndex].amount == o.amount
              && request.resource.data.entries[o.entryIndex].date == resource.data.entries[o.entryIndex].date
              && request.resource.data.saved == resource.data.saved - o.previousAmount + o.amount
              && request.resource.data.entries.removeAll([request.resource.data.entries[o.entryIndex]]) == resource.data.entries.removeAll([resource.data.entries[o.entryIndex]]))));
      }
      match /plans/{planId} {
        allow read: if owner() && planId in ['active','weekly','flexible','daily'];
        allow create: if owner() && validPlan() && request.resource.data.revision == 1
          && (planId == 'active' || planId == request.resource.data.mode)
          && ((planId == 'active' && !exists(planPath(request.resource.data.mode)))
            || (planId == request.resource.data.mode
              && (!exists(planPath('active'))
                || get(planPath('active')).data.mode != planId)))
          && operationCommittedWithPlan();
        allow update: if owner() && validPlan()
          && (planId == 'active' || planId == request.resource.data.mode)
          && request.resource.data.revision == resource.data.revision + 1
          && request.resource.data.mode == resource.data.mode
          && operationCommittedWithPlan();
        allow delete: if false;
      }
      match /plans/dream {
        allow read: if owner();
        allow create: if owner() && validDreamPlan() && request.resource.data.revision == 1
          && request.resource.data.saved == 0 && request.resource.data.entries.size() == 0
          && dreamOperationCommittedWithPlan()
          && getAfter(dreamOperationPath(request.resource.data.lastOperationId)).data.type == 'dream_created';
        allow update: if owner() && validDreamPlan()
          && request.resource.data.revision == resource.data.revision + 1
          && dreamOperationCommittedWithPlan()
          && dreamChangeMatchesOperation();
        allow delete: if false;
      }
      match /operations/{operationId} {
        allow read: if owner();
        allow create: if owner() && operationId.matches('^[a-f0-9-]{36}$')
          && validOperation()
          && (operationMatchesPlan('active', operationId)
            || operationMatchesPlan(request.resource.data.mode, operationId));
        allow update, delete: if false;
      }
      match /dreamOperations/{operationId} {
        allow read: if owner();
        allow create: if owner() && operationId.matches('^[a-f0-9-]{36}$')
          && validDreamOperation()
          && existsAfter(dreamPath())
          && getAfter(dreamPath()).data.lastOperationId == operationId
          && getAfter(dreamPath()).data.revision == request.resource.data.revision
          && getAfter(dreamPath()).data.purpose == request.resource.data.purpose
          && getAfter(dreamPath()).data.goal == request.resource.data.goal;
        allow update, delete: if false;
      }
      match /dreamMedia/{mediaId} {
        allow read: if owner() && mediaId == 'cover';
        allow create: if owner() && mediaId == 'cover' && existsAfter(dreamPath())
          && validDreamMedia() && request.resource.data.revision == 1
          && dreamMediaOperationCommitted();
        allow update: if owner() && mediaId == 'cover' && validDreamMedia()
          && request.resource.data.revision == resource.data.revision + 1
          && dreamMediaOperationCommitted();
        allow delete: if false;
      }
      match /dreamMediaOperations/{operationId} {
        allow read: if owner();
        allow create: if owner() && operationId.matches('^[a-f0-9-]{36}$')
          && validDreamMediaOperation() && existsAfter(dreamPhotoPath())
          && getAfter(dreamPhotoPath()).data.lastOperationId == operationId
          && getAfter(dreamPhotoPath()).data.revision == request.resource.data.revision;
        allow update, delete: if false;
      }
      match /notificationDevices/{installationId} {
        allow read, delete: if owner();
        allow create: if owner() && installationId.matches('^[A-Za-z0-9_-]{10,128}$')
          && request.resource.data.keys().hasAll(['installationId','enabled','updatedAt'])
          && request.resource.data.keys().hasOnly(['installationId','enabled','updatedAt'])
          && request.resource.data.installationId == installationId
          && request.resource.data.enabled == true
          && request.resource.data.updatedAt == request.time;
        allow update: if owner() && request.resource.data.installationId == installationId
          && request.resource.data.enabled == true
          && request.resource.data.updatedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['enabled','updatedAt']);
      }
      match /reminderDeliveries/{deliveryId} {
        allow read: if owner();
        allow write: if false;
      }
    }
  }
}
