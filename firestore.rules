rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      function owner() {
        return request.auth != null && request.auth.uid == userId;
      }
      function planPath() {
        return /databases/$(database)/documents/users/$(userId)/plans/active;
      }
      function operationPath(operationId) {
        return /databases/$(database)/documents/users/$(userId)/operations/$(operationId);
      }
      function validPlan() {
        let d = request.resource.data;
        return d.keys().hasAll(['mode','place','placeName','purpose','startDate','entries','revision','lastOperationId','updatedAt'])
          && d.keys().hasOnly(['mode','place','placeName','purpose','startDate','entries','revision','lastOperationId','updatedAt'])
          && d.mode in ['weekly','daily','flexible']
          && d.place in ['account','pocket','cash']
          && d.placeName is string && d.placeName.size() <= 60
          && d.purpose is string && d.purpose.size() >= 3 && d.purpose.size() <= 80
          && d.startDate is string && d.startDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && d.entries is list && d.entries.size() <= 200
          && d.revision is int && d.revision >= 1
          && d.lastOperationId is string && d.lastOperationId.matches('^[a-f0-9-]{36}$')
          && d.updatedAt == request.time;
      }
      function operationCommittedWithPlan() {
        let d = request.resource.data;
        return existsAfter(operationPath(d.lastOperationId))
          && getAfter(operationPath(d.lastOperationId)).data.revision == d.revision
          && getAfter(operationPath(d.lastOperationId)).data.mode == d.mode
          && getAfter(operationPath(d.lastOperationId)).data.purpose == d.purpose;
      }
      function validOperation() {
        let d = request.resource.data;
        return d.keys().hasAll(['type','revision','mode','amount','ids','entryId','shortcut','purpose','createdAt'])
          && d.keys().hasOnly(['type','revision','mode','amount','ids','entryId','shortcut','purpose','createdAt'])
          && d.type in ['plan_created','contribution_added','contribution_corrected','goal_updated']
          && d.revision is int && d.revision >= 1
          && d.mode in ['weekly','daily','flexible']
          && d.amount is int && d.amount >= 0 && d.amount <= 1195000
          && d.ids is list && d.ids.size() <= 200
          && d.entryId is string && d.entryId.size() <= 100
          && d.shortcut in ['','smile','heart','music','sun','triangle']
          && d.purpose is string && d.purpose.size() >= 3 && d.purpose.size() <= 80
          && d.createdAt == request.time
          && ((d.type in ['plan_created','goal_updated'] && d.amount == 0 && d.ids.size() == 0 && d.entryId == '')
            || (d.type in ['contribution_added','contribution_corrected'] && d.amount > 0 && d.ids.size() > 0 && d.entryId.size() > 0));
      }
      match /plans/active {
        allow read: if owner();
        allow create: if owner() && validPlan() && request.resource.data.revision == 1
          && operationCommittedWithPlan();
        allow update: if owner() && validPlan()
          && request.resource.data.revision == resource.data.revision + 1
          && request.resource.data.mode == resource.data.mode
          && operationCommittedWithPlan();
        allow delete: if false;
      }
      match /operations/{operationId} {
        allow read: if owner();
        allow create: if owner() && operationId.matches('^[a-f0-9-]{36}$')
          && validOperation()
          && existsAfter(planPath())
          && getAfter(planPath()).data.lastOperationId == operationId
          && getAfter(planPath()).data.revision == request.resource.data.revision
          && getAfter(planPath()).data.mode == request.resource.data.mode
          && getAfter(planPath()).data.purpose == request.resource.data.purpose;
        allow update, delete: if false;
      }
    }
  }
}
